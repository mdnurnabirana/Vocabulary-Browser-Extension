{
  "manifest_version": 3,
  "name": "IELTS Lookup",
  "version": "2.0.0",
  "description": "Private word lookup for IELTS: Bangla meaning, pronunciation, parts of speech, synonyms, antonyms, examples, and history.",
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://api.dictionaryapi.dev/*",
    "https://api.datamuse.com/*",
    "https://dictionary.cambridge.org/*",
    "https://www.oxfordlearnersdictionaries.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["core.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "IELTS Lookup" },
  "commands": {
    "lookup-selection": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Look up the selected word now (skip the wait)"
    }
  }
}