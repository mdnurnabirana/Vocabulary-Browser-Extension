{
  "manifest_version": 3,
  "name": "IELTS Lookup",
  "version": "2.1.0",
  "description": "Private bilingual word lookup for IELTS: Bangla and English meanings, pronunciation, definitions, examples, synonyms, antonyms, and history.",
  "key": "",
  "permissions": ["storage", "unlimitedStorage", "downloads", "alarms"],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://api.dictionaryapi.dev/*",
    "https://api.datamuse.com/*",
    "https://dictionary.cambridge.org/*",
    "https://www.oxfordlearnersdictionaries.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared.js", "styles.js", "core.js", "api.js", "render.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "IELTS Lookup",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "lookup-selection": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Look up the selected word now (skip the wait)"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["fonts/inter-latin.woff2", "fonts/noto-sans-bengali.woff2"],
      "matches": ["<all_urls>"]
    }
  ]
}
